    {
      "tag": "security-generic",
      "weight": 2,
      "note": "Generic security naming. Deliberately low-weight: it catches in-house channels like `app/security_check` that no specific tag would, at the cost of some noise.",
      "keywords": [
        "security",
        "secure",
        "protection",
        "protect",
        "threat",
        "harden",
        "obfusc",
        "antifraud",
        "anti_fraud",
        "fraud",
        "risk"
      ]
    },
    {
      "tag": "native-bridge",
      "weight": 1,
      "note": "Custom bridges are worth reading regardless of naming.",
      "keywords": ["native", "bridge", "platform_channel", "jni", "ffi", "plugin"]
    },
    {
      "tag": "pii",
      "weight": 2,
      "note": "Direct handling of personal data.",
      "keywords": [
        "location",
