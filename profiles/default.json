        "pincode",
        "biometric",
        "fingerprint",
        "faceid",
        "touchid",
        "localauth",
        "mfa",
        "otp",
        "2fa"
      ]
    },
    {
      "tag": "storage",
      "weight": 2,
      "note": "Local persistence where secrets tend to land.",
      "keywords": [
        "secure_storage",
        "securestorage",
        "sharedpreferences",
        "userdefaults",
        "sqlite",
        "database",
        "realm",
        "hive",
        "cache",
        "vault",
        "wallet"
      ]
    },
    {
      "tag": "network",
      "weight": 2,
      "note": "Transport configuration and proxy or VPN awareness.",
      "keywords": [
